{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "motolog-sales-cloudflare",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motolog-sales-production",
      "database_id": "e547f822-dab0-497f-9171-f90c562a0646"
    }
  ],
  "vars": {
    "MOTOLOG_REQUIRE_ACCESS": "true"
  }
}
